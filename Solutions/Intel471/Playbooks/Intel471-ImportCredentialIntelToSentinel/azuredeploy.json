{
    "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "title": "Intel 471 Credential Intelligence to Sentinel (iteration 1)",
        "description": "ITERATION 1 - single manual call. Calls the Verity credential-occurrences stream exactly once with the from and size values you supply, maps the results and writes them to the Intel471CredentialOccurrences_CL custom table. No cursor, no paging, no Key Vault - credentials are template parameters. NOTE ON TIMESTAMPS: TimeGenerated is the time this playbook ingested the row, NOT the time the credential was observed - Azure Monitor overwrites any TimeGenerated older than 2 days with the receipt time, which would make the column mean different things for fresh and backfilled data. Query LastUpdatedTime, FirstSeenTime or LastSeenTime for when the credential was actually seen.",
        "author": {
            "name": "Intel 471, Inc."
        }
    },
    "parameters": {
        "PlaybookName": {
            "defaultValue": "Intel471-ImportCredentialIntelToSentinel",
            "type": "String"
        },
        "WorkspaceName": {
            "type": "String",
            "minLength": 1,
            "metadata": {
                "description": "Name of the Log Analytics workspace that will hold the custom table."
            }
        },
        "WorkspaceResourceGroup": {
            "defaultValue": "",
            "type": "String",
            "metadata": {
                "description": "Resource group of the Log Analytics workspace. Leave empty to use the resource group this template is deployed into."
            }
        },
        "VerityUserName": {
            "type": "String",
            "minLength": 1,
            "metadata": {
                "description": "ITERATION 1 ONLY - Verity API Client ID, sent as the HTTP Basic user name. Moves to Key Vault in a later iteration."
            }
        },
        "VerityApiKey": {
            "type": "SecureString",
            "minLength": 1,
            "metadata": {
                "description": "ITERATION 1 ONLY - Verity API Client Secret, sent as the HTTP Basic password. Moves to Key Vault in a later iteration."
            }
        },
        "FromTimestamp": {
            "type": "String",
            "minLength": 1,
            "metadata": {
                "description": "Passed through to the API as the 'from' query parameter, unchanged. UNIX timestamp in MILLISECONDS (13 digits), e.g. 1756684800000."
            }
        },
        "Size": {
            "defaultValue": "100",
            "type": "String",
            "metadata": {
                "description": "Passed through to the API as the 'size' query parameter, unchanged. Range 1-1000. Keep at or below 100 for the first runs - the whole page is posted in one request and the Logs Ingestion API caps a request at 1 MB."
            }
        }
    },
    "variables": {
        "DceName": "dce-intel471-creds",
        "DcrName": "dcr-intel471-creds",
        "TableName": "Intel471CredentialOccurrences_CL",
        "StreamName": "Custom-Intel471CredentialOccurrences_CL",
        "WorkspaceRg": "[if(empty(parameters('WorkspaceResourceGroup')), resourceGroup().name, parameters('WorkspaceResourceGroup'))]",
        "WorkspaceResourceId": "[resourceId(variables('WorkspaceRg'), 'Microsoft.OperationalInsights/workspaces', parameters('WorkspaceName'))]"
    },
    "resources": [
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2021-04-01",
            "name": "Intel471-CredentialOccurrencesTable",
            "resourceGroup": "[variables('WorkspaceRg')]",
            "properties": {
                "mode": "Incremental",
                "expressionEvaluationOptions": {
                    "scope": "inner"
                },
                "parameters": {
                    "workspaceName": {
                        "value": "[parameters('WorkspaceName')]"
                    },
                    "tableName": {
                        "value": "[variables('TableName')]"
                    }
                },
                "template": {
                    "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
                    "contentVersion": "1.0.0.0",
                    "parameters": {
                        "workspaceName": {
                            "type": "string"
                        },
                        "tableName": {
                            "type": "string"
                        }
                    },
                    "resources": [
                        {
                            "type": "Microsoft.OperationalInsights/workspaces/tables",
                            "apiVersion": "2025-07-01",
                            "name": "[concat(parameters('workspaceName'), '/', parameters('tableName'))]",
                            "properties": {
                                "plan": "Analytics",
                                "schema": {
                                    "name": "[parameters('tableName')]",
                                    "columns": [
                                        {
                                            "name": "TimeGenerated",
                                            "type": "datetime"
                                        },
                                        {
                                            "name": "OccurrenceId",
                                            "type": "string"
                                        },
                                        {
                                            "name": "LastUpdatedTime",
                                            "type": "datetime"
                                        },
                                        {
                                            "name": "FirstSeenTime",
                                            "type": "datetime"
                                        },
                                        {
                                            "name": "LastSeenTime",
                                            "type": "datetime"
                                        },
                                        {
                                            "name": "CredentialId",
                                            "type": "string"
                                        },
                                        {
                                            "name": "CredentialLogin",
                                            "type": "string"
                                        },
                                        {
                                            "name": "AccountName",
                                            "type": "string"
                                        },
                                        {
                                            "name": "AccountUPNSuffix",
                                            "type": "string"
                                        },
                                        {
                                            "name": "CredentialDomain",
                                            "type": "string"
                                        },
                                        {
                                            "name": "DetectionDomain",
                                            "type": "string"
                                        },
                                        {
                                            "name": "Affiliations",
                                            "type": "dynamic"
                                        },
                                        {
                                            "name": "PasswordId",
                                            "type": "string"
                                        },
                                        {
                                            "name": "PasswordStrength",
                                            "type": "string"
                                        },
                                        {
                                            "name": "PasswordLength",
                                            "type": "int"
                                        },
                                        {
                                            "name": "PasswordEntropy",
                                            "type": "real"
                                        },
                                        {
                                            "name": "PasswordScore",
                                            "type": "real"
                                        },
                                        {
                                            "name": "PasswordWeakness",
                                            "type": "real"
                                        },
                                        {
                                            "name": "PasswordComplexity",
                                            "type": "dynamic"
                                        },
                                        {
                                            "name": "AccessedDomain",
                                            "type": "string"
                                        },
                                        {
                                            "name": "AccessedUrl",
                                            "type": "string"
                                        },
                                        {
                                            "name": "CredentialSetId",
                                            "type": "string"
                                        },
                                        {
                                            "name": "CredentialSetName",
                                            "type": "string"
                                        },
                                        {
                                            "name": "CredentialType",
                                            "type": "string"
                                        },
                                        {
                                            "name": "FilePath",
                                            "type": "string"
                                        },
                                        {
                                            "name": "SoftwareName",
                                            "type": "string"
                                        },
                                        {
                                            "name": "MalwareFamily",
                                            "type": "string"
                                        },
                                        {
                                            "name": "InfectionTime",
                                            "type": "datetime"
                                        },
                                        {
                                            "name": "MachineId",
                                            "type": "string"
                                        },
                                        {
                                            "name": "PcName",
                                            "type": "string"
                                        },
                                        {
                                            "name": "ComputerUsername",
                                            "type": "string"
                                        },
                                        {
                                            "name": "SourceIP",
                                            "type": "string"
                                        },
                                        {
                                            "name": "ISP",
                                            "type": "string"
                                        },
                                        {
                                            "name": "OperatingSystem",
                                            "type": "string"
                                        },
                                        {
                                            "name": "AntivirusSoftware",
                                            "type": "string"
                                        },
                                        {
                                            "name": "MalwareInstallPath",
                                            "type": "string"
                                        },
                                        {
                                            "name": "ScreenshotPath",
                                            "type": "string"
                                        },
                                        {
                                            "name": "StealerVersion",
                                            "type": "string"
                                        },
                                        {
                                            "name": "Girs",
                                            "type": "dynamic"
                                        },
                                        {
                                            "name": "SourceSystem",
                                            "type": "string"
                                        }
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        },
        {
            "type": "Microsoft.Insights/dataCollectionEndpoints",
            "apiVersion": "2023-03-11",
            "name": "[variables('DceName')]",
            "location": "[resourceGroup().location]",
            "properties": {
                "networkAcls": {
                    "publicNetworkAccess": "Enabled"
                }
            }
        },
        {
            "type": "Microsoft.Insights/dataCollectionRules",
            "apiVersion": "2023-03-11",
            "name": "[variables('DcrName')]",
            "location": "[resourceGroup().location]",
            "dependsOn": [
                "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('DceName'))]",
                "[resourceId('Microsoft.Resources/deployments', 'Intel471-CredentialOccurrencesTable')]"
            ],
            "properties": {
                "dataCollectionEndpointId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', variables('DceName'))]",
                "streamDeclarations": {
                    "Custom-Intel471CredentialOccurrences_CL": {
                        "columns": [
                            {
                                "name": "TimeGenerated",
                                "type": "datetime"
                            },
                            {
                                "name": "OccurrenceId",
                                "type": "string"
                            },
                            {
                                "name": "LastUpdatedTime",
                                "type": "datetime"
                            },
                            {
                                "name": "FirstSeenTime",
                                "type": "datetime"
                            },
                            {
                                "name": "LastSeenTime",
                                "type": "datetime"
                            },
                            {
                                "name": "CredentialId",
                                "type": "string"
                            },
                            {
                                "name": "CredentialLogin",
                                "type": "string"
                            },
                            {
                                "name": "AccountName",
                                "type": "string"
                            },
                            {
                                "name": "AccountUPNSuffix",
                                "type": "string"
                            },
                            {
                                "name": "CredentialDomain",
                                "type": "string"
                            },
                            {
