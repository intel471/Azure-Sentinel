                },
                "destinations": {
                    "logAnalytics": [
                        {
                            "workspaceResourceId": "[variables('WorkspaceResourceId')]",
                            "name": "laDestination"
                        }
                    ]
                },
                "dataFlows": [
                    {
                        "streams": [
                            "Custom-Intel471CredentialOccurrences_CL"
                        ],
                        "destinations": [
                            "laDestination"
                        ],
                        "transformKql": "source",
