                                "type": "string"
                            },
                            {
                                "name": "MalwareFamily",
                                "type": "string"
                            },
                            {
                                "name": "InfectionTime",
                                "type": "datetime"
                            },
                            {
                                "name": "MachineId",
                                "type": "string"
                            },
                            {
                                "name": "PcName",
                                "type": "string"
                            },
                            {
                                "name": "ComputerUsername",
                                "type": "string"
                            },
                            {
                                "name": "SourceIP",
                                "type": "string"
                            },
